# === API keys (fill these in) ===
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# === Supabase (Dashboard -> Settings -> API) ===
SUPABASE_URL=https://gnarrrwqzskmmpcuvomi.supabase.co
# service_role key (secret! bypasses RLS) — NOT the anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=

# === Model settings ===
# Codex reasoning model: gpt-6.1-terra (fast) | gpt-6.1-sol | gpt-6-astra
CODEX_MODEL=gpt-6.1-terra

# === Embedding / pipeline tuning ===
# Must stay 1536 — it matches the vector(1536) column in Supabase.
EMBED_DIM=1536
EMBED_BATCH_SIZE=16
# PDF pages per embedding part (hard max 6; parts are also shrunk adaptively
# to stay under the model's 8,192-token input limit)
PDF_PART_PAGES=6
MAX_VIDEO_SECONDS=120
MAX_AUDIO_SECONDS=180
TOP_K=5
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=200
